# ===== LeKiwi on Rhino Pi A1 — 部署配置 =====
# 用法：cp config/env.example config/env 后按实际修改
# 说明：key=value，不要加空格；# 开头为注释；支持 $HOME 这类变量展开
# 任何键都可以用同名环境变量临时覆盖

# ---------- 板卡（机器人端） ----------
BOARD_IP=192.168.1.100
BOARD_USER=aidlux
BOARD_REPO=$HOME/lekiwi-rhinopi-a1

# ---------- lerobot 代码 ----------
LEROBOT_DIR=$HOME/lerobot
# 两端必须一致；升级前先跑 README 第 6 节验收
LEROBOT_COMMIT=53feaef

# ---------- 机器人 ----------
ROBOT_ID=my_kiwi
ROBOT_PORT=/dev/ttyACM0

# ---------- 腕部相机 ----------
# 用 by-id 别名，重启/换 USB 口也不会变。查询：ls -l /dev/v4l/by-id/
# 留空 = 不启用相机（host 仍可启动，只是没有画面）
CAMERA_WRIST=/dev/v4l/by-id/usb-EXAMPLE_CAMERA_XXXX-video-index0
CAMERA_FPS=30
CAMERA_WIDTH=480
CAMERA_HEIGHT=640
# 画面需要旋转的角度：0 / 90 / 180 / 270
CAMERA_ROTATE=90

# ---------- host ----------
ZMQ_CMD_PORT=5555
ZMQ_OBS_PORT=5556
# 默认 30 秒无客户端就退出，必须放大
CONNECTION_TIME_S=3600

# ---------- 控制端（电脑） ----------
CLIENT_ID=my_lekiwi
# Windows 串口，换 USB 口会变。查询：scripts\win_bootstrap.ps1 -DetectOnly
LEADER_PORT=COM11
LEADER_ID=my_awesome_leader_arm
